				{ "slug": "surface-sunken", "name": "Surface sunken", "color": "#070A1C" },
				{ "slug": "border", "name": "Border", "color": "#2A3052" },
				{ "slug": "border-strong", "name": "Border strong", "color": "#6B75A3" },
				{ "slug": "ink", "name": "Ink", "color": "#f3f5fd" },
				{ "slug": "ink-muted", "name": "Ink muted", "color": "#B2B8D4" },
				{ "slug": "ink-subtle", "name": "Ink subtle", "color": "#9199BA" },
				{ "slug": "brand", "name": "Brand blue", "color": "#1A3BFF" },
				{ "slug": "brand-strong", "name": "Brand strong", "color": "#4756FF" },
				{ "slug": "brand-subtle", "name": "Brand subtle", "color": "#1B2150" },
				{ "slug": "brand-text", "name": "Brand text", "color": "#9AA6FF" },
				{ "slug": "on-brand", "name": "On brand", "color": "#ffffff" },
				{ "slug": "accent", "name": "Accent lime", "color": "#A3FF1A" },
				{ "slug": "accent-strong", "name": "Accent strong", "color": "#B6FF4D" },
				{ "slug": "accent-subtle", "name": "Accent subtle", "color": "#27320A" },
				{ "slug": "on-accent", "name": "On accent", "color": "#0B0F2A" },
				{ "slug": "positive", "name": "Positive", "color": "#34c88c" },
				{ "slug": "positive-subtle", "name": "Positive subtle", "color": "#10281f" },
				{ "slug": "caution", "name": "Caution", "color": "#e7a93a" },
				{ "slug": "caution-subtle", "name": "Caution subtle", "color": "#2e2410" },
				{ "slug": "critical", "name": "Critical", "color": "#f26b73" },
				{ "slug": "critical-subtle", "name": "Critical subtle", "color": "#2e1517" },
				{ "slug": "on-status", "name": "On status", "color": "#070A1C" }
