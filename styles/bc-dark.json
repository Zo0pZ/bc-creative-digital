		},
		"shadow": {
			"presets": [
				{ "slug": "sm", "name": "Small", "shadow": "0 1px 2px rgba(0,0,0,0.5)" },
				{ "slug": "md", "name": "Medium", "shadow": "0 6px 18px rgba(0,0,0,0.55)" },
				{ "slug": "lg", "name": "Large", "shadow": "0 18px 48px rgba(0,0,0,0.6)" },
				{ "slug": "brand", "name": "Brand lift", "shadow": "0 10px 28px rgba(26,59,255,0.45)" }
			]
		}
