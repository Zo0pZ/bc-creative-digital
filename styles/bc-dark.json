{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "BC Dark",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "surface", "name": "Surface", "color": "#0B0F2A" },
